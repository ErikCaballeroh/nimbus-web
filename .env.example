# Used starting Phase 3 (Postgres + Prisma). The Docker Postgres is exposed on
# host port 5433 (see docker-compose.yml) to avoid clashing with a native install.
DATABASE_URL="postgresql://nimbus:nimbus@localhost:5433/nimbus?schema=public"
SEED_PASSWORD="changeme123"

# Used by `pnpm test:integration` (a separate database so tests never
# touch dev data; created automatically by `pnpm db:up`, see db/init/)
TEST_DATABASE_URL="postgresql://nimbus:nimbus@localhost:5433/nimbus_test?schema=public"

# Used starting Phase 4 (auth sessions)
SESSION_SECRET="replace-with-a-long-random-string"

# Used starting Phase 7 by GET /api/cron/due-reminders (sent as the
# x-cron-secret header by the scheduled job that calls it)
CRON_SECRET="replace-with-a-long-random-string"
